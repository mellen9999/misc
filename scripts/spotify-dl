#!/bin/bash
# spotify-dl: auto-download spotify tracks played >80%
# Usage: spotify-dl [poll|download]
# Polls playerctl, downloads via yt-dlp as OPUS 128k

MUSIC_DIR="$HOME/sync/music"
HISTORY_FILE="$MUSIC_DIR/.downloaded"
LOG_FILE="$MUSIC_DIR/.spotify-dl.log"

mkdir -p "$MUSIC_DIR"
touch "$HISTORY_FILE"

log() { echo "[$(date +%H:%M:%S)] $*" | tee -a "$LOG_FILE"; }

_download() {
    local artist="$1" title="$2"
    local search="$artist - $title"

    grep -qxF "$search" "$HISTORY_FILE" 2>/dev/null && return 0

    log "Downloading: $search"
    local artist_dir
    artist_dir=$(echo "$artist" | tr -d '/:*?"<>|' | tr '[:upper:]' '[:lower:]' | tr ' ' '_')
    mkdir -p "$MUSIC_DIR/$artist_dir"

    yt-dlp \
        --extract-audio \
        --audio-format opus \
        --audio-quality 128K \
        --embed-thumbnail \
        --embed-metadata \
        --output "$MUSIC_DIR/$artist_dir/%(title)s.%(ext)s" \
        --no-playlist \
        --match-filter "duration < 600" \
        --quiet \
        "ytsearch1:$search official audio" && {
            echo "$search" >> "$HISTORY_FILE"
            log "Done: $search"
        } || {
            log "Failed: $search"
        }
}

_get_player() {
    for p in spotify spotifyd; do
        playerctl -p "$p" status &>/dev/null && echo "$p" && return
    done
    return 1
}

download_current() {
    local player
    player=$(_get_player) || { log "No spotify player found"; return 1; }
    local artist title
    artist=$(playerctl -p "$player" metadata xesam:artist 2>/dev/null)
    title=$(playerctl -p "$player" metadata xesam:title 2>/dev/null)
    [[ -z "$artist" || -z "$title" ]] && { log "No track info"; return 1; }
    _download "$artist" "$title"
}

poll() {
    log "Watching spotify (>80% = download as OPUS)..."
    local current="" track_len=0 max_pos=0 prev_artist="" prev_title=""

    while true; do
        local player
        player=$(_get_player)

        if [[ -n "$player" ]]; then
            local artist title status track_id
            artist=$(playerctl -p "$player" metadata xesam:artist 2>/dev/null)
            title=$(playerctl -p "$player" metadata xesam:title 2>/dev/null)
            track_id="$artist - $title"

            if [[ -n "$artist" && -n "$title" && "$track_id" != "$current" ]]; then
                if [[ -n "$current" && "$track_len" -gt 0 ]]; then
                    local pct=$((max_pos * 100 / track_len))
                    if [[ "$pct" -ge 80 ]]; then
                        log "Played $pct%: $current"
                        _download "$prev_artist" "$prev_title" &
                    else
                        log "Skipped ($pct%): $current"
                    fi
                fi

                current="$track_id"
                prev_artist="$artist"
                prev_title="$title"
                track_len=$(playerctl -p "$player" metadata mpris:length 2>/dev/null || echo 0)
                max_pos=0
                log "Now playing: $track_id"
            fi

            status=$(playerctl -p "$player" status 2>/dev/null)
            if [[ "$status" == "Playing" ]]; then
                local pos
                pos=$(playerctl -p "$player" position 2>/dev/null | cut -d. -f1)
                pos=$((pos * 1000000))
                [[ "$pos" -gt "$max_pos" ]] && max_pos="$pos"
            fi
        fi

        sleep 2
        systemd-notify WATCHDOG=1 2>/dev/null
    done
}

case "${1:-poll}" in
    download) download_current ;;
    poll)     poll ;;
    *)        echo "Usage: spotify-dl [poll|download]" ;;
esac
