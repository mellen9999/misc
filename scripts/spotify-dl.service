[Unit]
Description=Spotify auto-downloader (>80% played = saved as OPUS)
After=dbus.socket
Wants=dbus.socket

[Service]
Type=simple
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
ExecStart=%h/.local/bin/spotify-dl poll
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=20
WatchdogSec=120

[Install]
WantedBy=default.target
